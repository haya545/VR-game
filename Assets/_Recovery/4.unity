    - {fileID: 8300000, guid: f0761463e724a424a81857c3a32b2c07, type: 3}
    effects: []
  - text: "\u3053\u3046\u3044\u3046\u6642\u306F\u9178\u7D20\u304C\u307B\u3057\u3044\u306A\u3002"
    dialogueImage: {fileID: 1306451464, guid: e47ca525e0885024c9212872e6134b4a, type: 3}
