  m_Script: {fileID: 11500000, guid: 3f5239e88db25c64fbca7243a773c3d8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuestNPC
  requiredElement: SteakCooked
  requiredAmount: 5
  beforeQuestDialogues:
  - text: "\u3060\u3001\u8AB0\u304B\u305F\u3059\u3051\u3066\u304F\u308C\u3002"
    dialogueImage: {fileID: -2059318344, guid: c9b61b738ff78704cae7f4edd9c97610, type: 3}
    soundEffects:
    - {fileID: 8300000, guid: f0761463e724a424a81857c3a32b2c07, type: 3}
    effects: []
  - text: "\u6751\u306E\u307F\u3093\u306A\u306E\u305F\u3081\u306B\u98DF\u6599\u3092\u53D6\u308D\u3046\u3068\u3057\u3066\u3093\u3060\u3051\u3069"
    dialogueImage: {fileID: 676533961, guid: 49700779e3782b3419b0a98b8daf6915, type: 3}
    soundEffects:
    - {fileID: 8300000, guid: f0761463e724a424a81857c3a32b2c07, type: 3}
    effects: []
  - text: "\u7372\u7269\u304C\u3042\u306E\u30AA\u30FC\u30AF\u306A\u3093\u3060\u3002"
    dialogueImage: {fileID: -925341869, guid: 2e4db6ce46e6f4644888c3cd01ffe5ff, type: 3}
    soundEffects:
    - {fileID: 8300000, guid: f0761463e724a424a81857c3a32b2c07, type: 3}
    effects: []
  - text: "\u305F\u3060\u4FFA\u3089\u3058\u3083\u52DD\u3066\u306A\u3044\u3002"
    dialogueImage: {fileID: -925341869, guid: 86317130de348954eb304bc5d74ebfe0, type: 3}
    soundEffects:
    - {fileID: 8300000, guid: f0761463e724a424a81857c3a32b2c07, type: 3}
    effects: []
  - text: "\u4EE3\u308F\u308A\u306B\u5012\u3057\u3066\u304F\u308C\u306A\u3044\u304B\uFF1F"
    dialogueImage: {fileID: 294032811, guid: ed1f22f9f9432144ead4f07bf685d974, type: 3}
    soundEffects:
    - {fileID: 8300000, guid: f0761463e724a424a81857c3a32b2c07, type: 3}
    effects: []
  afterQuestDialogues:
  - text: "\u30DF\u30C3\u30B7\u30E7\u30F3\u30AF\u30EA\u30A2\uFF01\uFF01"
    dialogueImage: {fileID: 0}
    soundEffects:
    - {fileID: 8300000, guid: 76d9af04c65a2e54eb6c31d936397d39, type: 3}
    - {fileID: 8300000, guid: d9a6fd8ad2f148d4dabc403d40e92df1, type: 3}
    effects:
    - {fileID: 100006, guid: 450dff828997cdd4c864f611df7d62d5, type: 3}
    - {fileID: 100006, guid: 4a208ba3b61f6e24595fe9f17926de8e, type: 3}
    - {fileID: 100008, guid: 8bd82d4797b26664c85cbfa5b50a59c1, type: 3}
  - text: "\u3042\u308A\u304C\u3068\u3046\u3002\u3053\u308C\u3067\u6751\u306E\u4EBA\u304C\u98E2\u3048\u305A\u306B\u3059\u3080\u3088"
    dialogueImage: {fileID: -1851549872, guid: 8bd32d2dff510f645ac664876bdf6eef, type: 3}
    soundEffects:
    - {fileID: 8300000, guid: f0761463e724a424a81857c3a32b2c07, type: 3}
    effects: []
  - text: "\u3061\u306A\u307F\u306B\u8089\u3092\u713C\u304F\u3068\u9ED2\u304F\u306A\u308B\u306E\u306F\u30E1\u30A4\u30E9\u30FC\u30C9\u73FE\u8C61\u3068\u547C\u3070\u308C\u308B\u3082\u306E\u306E\u305B\u3044\u3060\u3002"
    dialogueImage: {fileID: 941610686, guid: b5aeaf0f0b0954b449504b17c69c65f1, type: 3}
    soundEffects:
    - {fileID: 8300000, guid: d9a6fd8ad2f148d4dabc403d40e92df1, type: 3}
    effects: []
  - text: "\u3061\u306A\u307F\u306B\u8089\u3092\u713C\u304F\u3068\u9ED2\u304F\u306A\u308B\u306E\u306F\u30E1\u30A4\u30E9\u30FC\u30C9\u53CD\u5FDC\u3068\u547C\u3070\u308C\u308B\u3002"
    dialogueImage: {fileID: -1404104532, guid: a15f2395bb3239f4c9ffb3b52fec08e5, type: 3}
    soundEffects:
    - {fileID: 8300000, guid: f0761463e724a424a81857c3a32b2c07, type: 3}
    effects:
    - {fileID: 100006, guid: 450dff828997cdd4c864f611df7d62d5, type: 3}
    - {fileID: 100006, guid: 4a208ba3b61f6e24595fe9f17926de8e, type: 3}
    - {fileID: 100008, guid: 8bd82d4797b26664c85cbfa5b50a59c1, type: 3}
  - text: "\u30E1\u30A4\u30E9\u30FC\u30C9\u53CD\u5FDC\u306F\u71B1\u306B\u3088\u3063\u3066\u30BF\u30F3\u30D1\u30AF\u8CEA\u3068\u7CD6\u304C\u7D50\u5408\u3059\u308B\u3053\u3068\u306B\u3088\u3063\u3066\u304A\u3053\u308B"
