    soundEffects:
    - {fileID: 8300000, guid: f0761463e724a424a81857c3a32b2c07, type: 3}
    effects: []
  - text: "\u80A5\u6599\u3092\u307E\u304B\u306A\u3044\u3068"
    dialogueImage: {fileID: 1366095999, guid: c4bdebf898b86ff43a0520acb91bd700, type: 3}
    soundEffects:
    - {fileID: 8300000, guid: f0761463e724a424a81857c3a32b2c07, type: 3}
    effects: []
  - text: "\u7A92\u7D20\uFF08N\uFF09\u306F\u571F\u306B\u6DF7\u305C\u308B\u3068\u4F5C\u7269\u306E\u751F\u80B2\u304C\u826F\u304F\u306A\u308B"
    dialogueImage: {fileID: -1479151858, guid: 230198b145cd91944b6901f2aabc832e, type: 3}
    soundEffects:
    - {fileID: 8300000, guid: f0761463e724a424a81857c3a32b2c07, type: 3}
    effects: []
  - text: "\u7A92\u7D20\uFF08N\uFF09\u30925\u500B\u6301\u3063\u3066\u304D\u3066\u304F\u308C\u306A\u3044\u304B"
    dialogueImage: {fileID: 178732451, guid: 8d4491f0acbc63344b612b7c696a5033, type: 3}
    soundEffects:
    - {fileID: 8300000, guid: f0761463e724a424a81857c3a32b2c07, type: 3}
    effects: []
  - text: "\u7A92\u7D20\uFF08N\uFF09\u306F\u9283\u3067\u4E0A\u3092\u6253\u3064\u3068\u624B\u306B\u5165\u308B"
    dialogueImage: {fileID: 909893598, guid: 8f6a9824da53d854b93288c409686337, type: 3}
